# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Values here are defaults only — anything already exported in your shell wins,
# so a one-off `GIT_STATS_REPO=owner/name git-stats collect` still overrides.

# The repository to track, as owner/name. Required — there is no default, so
# that a misconfigured run fails instead of quietly archiving someone else's
# numbers. The -repo flag overrides it for a single run.
GIT_STATS_REPO=owner/name

# CLASSIC personal access token with the "public_repo" scope.
#
# It must be a classic token: the Traffic API refuses fine-grained tokens even
# when they carry the Administration:read permission it advertises as required.
# Without a working token the traffic endpoints 403 and views, clones, referrers
# and paths are not collected — and GitHub deletes those after 14 days.
#
# Release download counts and repo counters need no token at all.
GIT_STATS_TOKEN=

# Release asset filename prefix, used for the per-platform breakdown of assets
# named <prefix>-<version>-<os>-<arch>.<ext>. Defaults to the repository name,
# which is what release tooling overwhelmingly produces. Set it only if your
# project publishes under a different name than its repository. Assets that do
# not match are still counted, just without a platform.
#GIT_STATS_ASSET_PREFIX=

# Data directory holding raw/ and stats.db. Defaults to ./data.
#GIT_STATS_DIR=data

# API host. Defaults to https://api.github.com. GitHub Enterprise Server puts
# the REST API under https://HOST/api/v3 — point this there to track a
# repository hosted on it. Every endpoint this tool uses exists there too.
#GIT_STATS_API_BASE=
